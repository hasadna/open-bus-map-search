# Keep this tag in step with the @playwright/test pin in package.json: the browsers baked
# into the image have to be the revision playwright-core expects.
FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app

# Upgrade npm to match the version used to generate the lock file
RUN npm install -g npm@11

# Install npm dependencies
COPY package*.json ./
RUN npm ci

# A no-op while the base tag matches the pin above, and the thing that keeps the image
# working if they ever drift: the test run itself is offline and cannot fetch a browser.
RUN npx playwright install chromium

COPY . .

CMD ["npm", "test"]
