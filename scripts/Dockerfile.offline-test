# Matching the @playwright/test pin in package.json means the install step below finds
# its browser already baked in. Drift is survivable, it just costs a ~150MB download.
FROM mcr.microsoft.com/playwright:v1.63.0-noble

WORKDIR /app

# Upgrade npm to match the version used to generate the lock file
RUN npm install -g npm@11

# Install npm dependencies
COPY package*.json ./
RUN npm ci

# The test run has no network, so the browser must already be in the image.
RUN npx playwright install chromium

COPY . .

CMD ["npm", "test"]
