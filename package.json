{
  "name": "open-bus-map-search",
  "version": "1.6.1",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hasadna/open-bus-api-client": "^1.2.5",
    "@juggle/resize-observer": "^3.4.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/stylis-plugin-rtl": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@mui/x-tree-view": "^9.14.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tanstack/query-async-storage-persister": "^5.104.1",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-query-persist-client": "^5.104.1",
    "antd": "^6.6.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "es-toolkit": "^1.52.0",
    "geolib": "^3.3.14",
    "i18next": "^26.4.2",
    "i18next-fs-backend": "^2.6.8",
    "idb-keyval": "^6.3.0",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-ga4": "^3.0.1",
    "react-i18next": "^17.0.15",
    "react-leaflet": "^5.0.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "stylis": "^4.4.0",
    "use-konami": "^1.0.1",
    "usehooks-ts": "^3.1.1"
  },
  "resolutions": {
    "autoprefixer": "10.4.5"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "build": "nx exec -- npm run _build && node sitemap.js",
    "serve": "vite preview",
    "test": "vitest run && playwright test --grep-invert visual",
    "test:e2e:ui": "cross-env APPLITOOLS_BATCH_ID=`uuidgen` playwright test --ui",
    "test:e2e": "cross-env APPLITOOLS_BATCH_ID=`uuidgen` playwright test",
    "test:e2e:visual": "playwright test tests/visual.spec.ts",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ci": "vitest run --coverage",
    "lint": "tsc --noEmit && eslint --max-warnings 0 && stylelint '**/*.{css,scss}' --max-warnings 0 && prettier . -c -u",
    "lint:fix": "eslint --fix && stylelint '**/*.{css,scss}' --fix && prettier . -w -u",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "nx exec -- storybook build",
    "_build": "tsc && vite build",
    "test:storybook": "eyes-storybook",
    "test:offline": "bash scripts/test-offline.sh"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@applitools/eyes-playwright": "^1.49.4",
    "@applitools/eyes-storybook": "^3.68.9",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.4",
    "@nx/eslint-plugin": "^23.2.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/stylis": "^4.2.7",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "lightningcss": "^1.33.0",
    "msw": "^3.0.2",
    "msw-storybook-addon": "^3.0.3",
    "nx": "^23.2.1",
    "playwright-advanced-har": "^1.4.1",
    "playwright-assertions": "^1.0.1",
    "prettier": "^3.9.9",
    "sass": "^1.105.1",
    "storybook": "^10.6.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-prettier": "^5.0.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "nx": {
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "build-storybook": {
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      }
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
